PORT=5001

# NOTE: the original file had a ";" at the end of this line, which becomes part
# of the database name and makes the connection fail. Removed.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/booking_db

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_EXCHANGE=rideshare.events
RABBITMQ_QUEUE=notification.events

# ---------------------------------------------------------------------------
# Booking lifecycle (driver side) settings
# ---------------------------------------------------------------------------

# Base URL of the Ride Service. The booking service asks it "who is the driver
# of this ride and how many seats does it have?".
# Leave EMPTY while the Ride Service is not ready -> the DEV_* values below
# are used instead, so you can test everything on your own laptop.
RIDE_SERVICE_URL=

# Used ONLY when RIDE_SERVICE_URL is empty (local development).
# Every ride is treated as belonging to this driver with this many seats.
# Must be a UUID, because driver_id is a UUID column in the database.
# Use the SAME value in the driver app (driver-app/src/config/api.js).
DEV_DRIVER_ID=11111111-1111-4111-8111-111111111111
DEV_RIDE_TOTAL_SEATS=4
