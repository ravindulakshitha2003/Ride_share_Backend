PORT=5004
NODE_ENV=development

# Booking Service owns this database. Do not point it at Ride Service's database.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/booking_db

# Base URL of the Ride Service. Change this to your actual service URL.
RIDE_SERVICE_URL=http://localhost:5002

# Secret used to verify user JWTs. Use the same signing secret/public-key
# arrangement as your Identity Service. Never commit the real secret.
JWT_SECRET=replace_with_the_same_jwt_secret

# RabbitMQ connection and event exchange.
RABBITMQ_URL=amqp://localhost:5672
BOOKING_EVENTS_EXCHANGE=booking.events

# How often the outbox publisher checks for unpublished events.
OUTBOX_POLL_INTERVAL_MS=3000
